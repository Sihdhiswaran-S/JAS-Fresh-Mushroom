# ── Server ──────────────────────────────
PORT=5000

# ── Gmail SMTP (Nodemailer) ──────────────
# Use your Gmail address as the sender
GMAIL_USER=your_gmail_address@gmail.com

# Generate an App Password at:
# Google Account → Security → 2-Step Verification → App Passwords
# Do NOT use your regular Gmail password here.
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Email Recipients ─────────────────────
# The email address that receives contact form submissions
RECIPIENT_EMAIL=your_gmail_address@gmail.com

# ── CORS ─────────────────────────────────
# Vite dev server origin — change to your production domain when deployed
ALLOWED_ORIGIN=http://localhost:5173
